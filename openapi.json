        "/saveup/users/{user_id}/verify": {
            "post": {
                "tags": [
                    "Users"
                ],
                "summary": "Verify user ID and upload documents",
                "description": "Route to verify a user’s identity by providing ID details and associated documents.",
                "security": [
                    {
                        "Authorization": []
                    }
                ],
                "parameters": [
                    {
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "The unique numeric user id"
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "me"
                                    ],
                                    "description": "- `me`: Special id `me` to rep the currently logged in user.\n"
                                }
                            ]
                        },
                        "required": true,
                        "name": "user_id",
                        "in": "path"
                    },
                    {
                        "schema": {
                            "type": "boolean",
                            "description": "If true, send a notification after verification"
                        },
                        "required": false,
                        "description": "If true, send a notification after verification",
                        "name": "notify",
                        "in": "query"
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "id_details": {
                                        "type": "object",
                                        "properties": {
                                            "id_type": {
                                                "type": "string",
                                                "enum": [
                                                    "NATIONAL_ID",
                                                    "PASSPORT"
                                                ],
                                                "description": "Type of identification document"
                                            },
                                            "id_number": {
                                                "type": "string",
                                                "pattern": "^(?:[A-Z]{1,2}\\d{6,9}|\\d{8,10}|\\d{13}|\\d{16})$",
                                                "description": "Identification number matching the selected type"
                                            }
                                        },
                                        "required": [
                                            "id_type",
                                            "id_number"
                                        ],
                                        "description": "Object containing ID document details"
                                    },
                                    "documents": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "description": "Document name, e.g., \"Front of ID\""
                                                },
                                                "url": {
                                                    "type": "string",
                                                    "format": "uri",
                                                    "description": "Link to the uploaded document"
                                                }
                                            },
                                            "required": [
                                                "name",
                                                "url"
                                            ]
                                        },
                                        "description": "List of uploaded documents for verification"
                                    }
                                },
                                "required": [
                                    "id_details",
                                    "documents"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "description": "Whether the verification succeeded"
                                        },
                                        "verified_user": {
                                            "type": "object",
                                            "properties": {
                                                "user_id": {
                                                    "type": "number",
                                                    "description": "User ID of the verified user"
                                                },
                                                "verified_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "description": "Timestamp of when the user was verified"
                                                }
                                            },
                                            "required": [
                                                "user_id",
                                                "verified_at"
                                            ],
                                            "additionalProperties": false,
                                            "description": "An object with Information about the verified user"
                                        }
                                    },
                                    "required": [
                                        "success",
                                        "verified_user"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}