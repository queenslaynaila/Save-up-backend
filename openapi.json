                                                                        "enum": [
                                                                            "money"
                                                                        ]
                                                                    },
                                                                    "value": {
                                                                        "type": "object",
                                                                        "additionalProperties": {
                                                                            "type": "number"
                                                                        },
                                                                        "description": "Minimum required deposit per country."
                                                                    }
                                                                },
                                                                "required": [
                                                                    "scope",
                                                                    "type",
                                                                    "value"
                                                                ],
                                                                "additionalProperties": false,
                                                                "description": "Minimum deposit amount to qualify for the bonus."
                                                            },
                                                            "percentage_bonus": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "scope": {
