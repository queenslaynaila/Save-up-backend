                                                                "type": "object",
                                                                "properties": {
                                                                    "scope": {
                                                                        "type": "string",
                                                                        "enum": [
                                                                            "global"
                                                                        ]
                                                                    },
                                                                    "type": {
                                                                        "type": "string",
                                                                        "enum": [
                                                                            "number"
                                                                        ]
                                                                    },
                                                                    "value": {
                                                                        "type": "number",
                                                                        "description": "Number of days allowed to meet wagering requirements."
                                                                    }
                                                                },
                                                                "required": [
