{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["es5", "es6", "ES2018"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "commonjs",
    "typeRoots": ["./globalTypes","node_modules/@types"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowJs": false,
    "outDir": "./dist",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}